{
  "name": "service-quality-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "quality:import": "node server/scripts/import-quality.js",
    "quality:import:test": "node server/scripts/import-quality.test.js",
    "test:reports": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test client/src/pages/Reports/engine/tests/reports.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
