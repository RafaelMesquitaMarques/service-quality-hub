# Optional: copy to .env next to docker-compose.yml to override its defaults.
# Never commit .env.

# Supabase project the app talks to (default: the production project, same
# values as client/.env.local). Vite bakes these into the bundle at build
# time, so a change needs `docker compose up --build -d`. Only the public anon
# key goes here, NEVER the service key.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>

# Host port nginx is published on (default 15105, the port IT assigned on the
# Azure VMs). Locally, any free port.
WEB_PORT=8080
