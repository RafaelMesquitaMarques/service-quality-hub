# Copy to .env next to docker-compose.yml. Never commit .env.

# Supabase project the app talks to. Vite bakes these into the bundle at build
# time, so a change needs `docker compose up --build -d`. The anon key is the
# public one (it ends up in the browser anyway); NEVER put the service key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>

# Host port nginx is published on (on the Azure VM: the port IT assigns).
WEB_PORT=8080
